<?xml version="1.0" encoding="utf-8"?>

<!--
    Central package management: every package version used in the repository is pinned here.
    Versions are aligned with mrploch-development/dependencies/*.Packages.props; Dependabot keeps them current.
-->
<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup Label="Build">
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageVersion Include="AutoFixture.Xunit3" Version="4.19.0" />
        <!-- xUnit 4 runs on Microsoft.Testing.Platform (MTP) v2, which refuses the VSTest mode of dotnet test on the
             .NET 10 SDK; global.json selects the MTP mode. Coverage (coverlet.MTP) and TRX are MTP extensions. -->
        <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
        <PackageVersion Include="FluentAssertions" Version="8.11.0" />
        <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>

    <ItemGroup Label="Analysers">
        <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.201" />
        <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" />
        <GlobalPackageReference Include="Roslynator.Analyzers" Version="4.15.0" />
        <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.21.0.135717" />
        <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.3.180" />
    </ItemGroup>
</Project>
